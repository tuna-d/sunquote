# Copy to `.env` to override a default. Every variable is optional; `.env` is not committed.
# Commented-out lines show the default value.

# --- Application (read by sunquote.config.Settings) ---
# Log level of the `sunquote` loggers: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# SUNQUOTE_LOG_LEVEL=INFO

# --- Docker Compose only ---
# Host port the API is published on (the container always listens on 8000).
# API_HOST_PORT=8000
