# Copy to `.env` to override a default. Every variable is optional; `.env` is not committed.
# Commented-out lines show the default value.

# --- Application (read by sunquote.config.Settings) ---
# Log level of the `sunquote` loggers: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# SUNQUOTE_LOG_LEVEL=INFO
# Directory with `catalog.toml`, `assumptions.toml` and `tariff.toml`. Empty means the placeholder files
# that ship inside the package.
# SUNQUOTE_DATA_DIR=
# Where Quotes are stored: an async SQLAlchemy URL of a Postgres database. Docker Compose sets
# its own. The default matches the Compose Postgres service published on localhost.
# SUNQUOTE_DATABASE_URL=postgresql+asyncpg://sunquote:sunquote@localhost:5432/sunquote
# Apply the database migrations when the API starts. Turn off only when something else does.
# SUNQUOTE_MIGRATE_ON_STARTUP=true
# Optional Redis cache URL. Unset means caching is disabled. Docker Compose sets its own.
# SUNQUOTE_REDIS_URL=redis://localhost:6379/0
# Nominatim base URL and per-request timeout. No key is needed.
# SUNQUOTE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# SUNQUOTE_NOMINATIM_TIMEOUT_SECONDS=10
# PVGIS (EU Joint Research Centre) base URL and per-request timeout. No key is needed.
# SUNQUOTE_PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_3
# SUNQUOTE_PVGIS_TIMEOUT_SECONDS=10
# TCMB (Turkish central bank) daily exchange rate files and per-request timeout. No key is
# needed. The Exchange Rate of a Quote can also be given in the request.
# SUNQUOTE_TCMB_BASE_URL=https://www.tcmb.gov.tr/kurlar
# SUNQUOTE_TCMB_TIMEOUT_SECONDS=10
# Total time the Narrative writer gets for both attempts when a Quote is created. Past it the
# Quote shows the fixed Turkish text. Has an effect only when a Gemini key is set.
# SUNQUOTE_NARRATIVE_TIMEOUT_SECONDS=15
# Free Gemini API key (SECRET, never commit .env). Create one at https://aistudio.google.com/apikey
# with no billing. When set, each new Quote's Narrative is written by Gemini; when empty or unset,
# Quotes use the fixed Turkish text and nothing is sent anywhere. Only an anonymised description
# of the Quote is sent (no name, address or contact detail), because the free tier may use
# submitted content to improve Google's products.
# SUNQUOTE_GEMINI_API_KEY=
# Model that writes the Narrative. It must be on Gemini's free tier: the default was checked on
# Google's pricing page on 2026-11-24. Paid tiers are never assumed.
# SUNQUOTE_GEMINI_MODEL=gemini-3.5-flash-lite
# Timeout of one Gemini request in seconds (the Narrative budget above bounds both attempts).
# SUNQUOTE_GEMINI_TIMEOUT_SECONDS=10
# Gemini API base URL.
# SUNQUOTE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Docker Compose only ---
# Host port the API is published on (the container always listens on 8000).
# API_HOST_PORT=8000
# Password of the Postgres database (user and database are both `sunquote`) and the host
# port it is published on (localhost only).
# POSTGRES_PASSWORD=sunquote
# POSTGRES_HOST_PORT=5432
# Host port the Redis cache is published on (localhost only).
# REDIS_HOST_PORT=6379

# --- Tests only ---
# Delay between Gemini calls in `uv run pytest -m eval`, including retries.
# SUNQUOTE_EVAL_DELAY_SECONDS=15
# `uv run pytest -m integration` makes one real Gemini call when SUNQUOTE_GEMINI_API_KEY is set,
# and skips that test otherwise.
# Database the Postgres repository tests run against. Each test works in its own temporary
# schema. Without it those tests are skipped.
# SUNQUOTE_TEST_DATABASE_URL=postgresql+asyncpg://sunquote:sunquote@127.0.0.1:5432/sunquote
# Redis database for cache tests. Use a separate database from the application's cache.
# SUNQUOTE_TEST_REDIS_URL=redis://127.0.0.1:6379/15
